#!/usr/bin/env python3
"""
Launcher script for Markora (Sovereign Markdown Notebook & Todo TUI)
"""

import sys
import os

# Resolve real path in case of symlink
real_file = os.path.realpath(__file__)
src_path = os.path.abspath(os.path.join(os.path.dirname(real_file), "..", "src"))

if os.path.isdir(src_path) and src_path not in sys.path:
    sys.path.insert(0, src_path)

# Auto-switch to isolated venv if available
for venv_py in [
    os.path.expanduser("~/.local/share/markora-venv/bin/python"),
    os.path.expanduser("~/.local/share/td-venv/bin/python"),
]:
    if os.path.exists(venv_py) and sys.executable != venv_py:
        os.execv(venv_py, [venv_py] + sys.argv)
        break

from markora.cli import main

if __name__ == "__main__":
    main()
